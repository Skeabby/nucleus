{
  "name": "nucleus",
  "version": "0.0.0",
  "description": "The creative suite that runs itself: one command bus for the GUI, CLI, JSON-RPC and MCP; drop-in apps in native WebView2 windows. No Electron.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Skeabby/nucleus.git"
  },
  "homepage": "https://github.com/Skeabby/nucleus",
  "keywords": [
    "nucleus",
    "launcher",
    "desktop",
    "webview2",
    "pdf",
    "mcp",
    "monorepo",
    "typescript"
  ],
  "private": true,
  "type": "module",
  "packageManager": "npm@11.17.0",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "verify": "turbo run build typecheck test && npm run demo:cross-app",
    "clean": "turbo run clean",
    "codegen": "node tools/codegen.mjs",
    "scoreboard": "node tools/scoreboard.mjs",
    "nucleus": "node packages/launcher/dist/cli.js",
    "start": "node packages/launcher/dist/cli.js up",
    "start:launcher": "npm --workspace @nucleus/launcher-app run start",
    "start:pdf": "npm --workspace @nucleus/pdf-workbench run start",
    "mcp": "node packages/control-mcp/dist/index.js",
    "mcp:federation": "node packages/control-federation/dist/mcp.js",
    "demo:cross-app": "node packages/control-federation/dist/demo.js",
    "bundle:apps": "node scripts/bundle-apps.mjs",
    "check:apps": "node scripts/check-bundled-app.mjs apps/notes && node scripts/check-bundled-app.mjs apps/pdf-workbench && node scripts/check-bundled-app.mjs apps/launcher",
    "shell": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-shell.ps1",
    "shell:fetch": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/fetch-webview2.ps1",
    "shortcut": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/install-shortcut.ps1"
  },
  "devDependencies": {
    "@types/node": ">=22.0.0",
    "esbuild": "0.28.2",
    "turbo": "^2.11.7",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  }
}
