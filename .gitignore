# dependencies
node_modules/

# build output
dist/
*.tsbuildinfo

# bundled web kit copy (regenerated by scripts/bundle-apps.mjs from
# packages/app-kit/kit -- the package copy is the source of truth)
apps/*/public/_kit/

# local release/pack workspace
build/

# vendored at build time (copied from node_modules)
apps/pdf-workbench/public/vendor/

# generated shortcut icon (pack root only — the launcher's embedded OFL fonts are tracked)
/assets/

# rust (launcher-rs)
launcher-rs/target/
launcher-rs/mirror/*.nucleusapp

# turbo
.turbo/

# test output
coverage/

# logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# editor / os
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json

# local env
.env
.env.local

# N1 signing keys: `tools/sign-catalog.mjs --generate` writes them outside the
# tree, never here. The public key lives in the binary, not as a file.
*.private.pem
*.public.pem
nucleus-keys/
